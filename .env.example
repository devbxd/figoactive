# Optional: order email notifications (resend.com free tier). Without this,
# checkout still works — the customer can still confirm via WhatsApp from
# the confirmation screen — but the owner won't get an email for new orders.
RESEND_API_KEY=re_...
OWNER_NOTIFICATION_EMAIL=owner@example.com

# Public site URL — used for the sitemap, robots.txt, and email links.
NEXT_PUBLIC_SITE_URL=https://figoactive.com
