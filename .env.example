# Optional: order email notifications (resend.com free tier). Without this,
# checkout still works — the customer can still confirm via WhatsApp from
# the confirmation screen — but the owner won't get an email for new orders.
RESEND_API_KEY=re_...
OWNER_NOTIFICATION_EMAIL=owner@example.com

# Public site URL — used for the sitemap, robots.txt, and email links.
NEXT_PUBLIC_SITE_URL=https://figoactive.com

# Optional: Meta Pixel (Facebook/Instagram ads tracking + retargeting).
# Get this from Meta Business Suite → Events Manager → your pixel →
# Settings. Without it, the site just doesn't load the pixel script —
# nothing breaks.
NEXT_PUBLIC_META_PIXEL_ID=123456789012345

# Required: Supabase project (catalog database + /admin dashboard).
# Settings → API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
